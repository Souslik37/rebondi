---
// Panneau « Personnaliser » (temporaire) : nom du site, palettes en duo, couleurs sur mesure,
// et lien de partage. Activé par "themePicker": true dans src/data/site.json.
import { PRESETS, BRANDS } from '../lib/themes';
const section = 'mt-4 first:mt-0';
const title = 'mb-2 text-xs font-extrabold uppercase tracking-wider text-muted';
---
<details id="preview-panel" class="fixed bottom-24 left-3 z-50 md:bottom-4">
  <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-full border-2 border-ink bg-white px-4 text-sm font-bold text-ink shadow-lg [&::-webkit-details-marker]:hidden">
    <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="8.5" cy="10" r="1.6" fill="currentColor" /><circle cx="12" cy="7.5" r="1.6" fill="currentColor" /><circle cx="15.5" cy="10" r="1.6" fill="currentColor" /></svg>
    Personnaliser
  </summary>
  <div class="mt-2 max-h-[70dvh] w-[min(22rem,calc(100vw-1.5rem))] overflow-y-auto rounded-3xl border-2 border-line bg-white p-4 text-ink shadow-xl">
    <fieldset class={section}>
      <legend class={title}>Nom du site</legend>
      <div class="grid grid-cols-2 gap-2">
        {BRANDS.map((b) => (
          <label class="flex min-h-11 cursor-pointer flex-col justify-center rounded-2xl border-2 border-line px-3 py-2 text-sm has-[:checked]:border-ink has-[:checked]:bg-cream">
            <input type="radio" name="pv-brand" value={b.id} class="sr-only" />
            <span class="font-bold">{b.name}</span>
            <span class="text-xs text-muted">{b.domain}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class={section}>
      <legend class={title}>Palettes</legend>
      <div class="grid grid-cols-3 gap-2">
        {PRESETS.map((t) => (
          <label class="flex cursor-pointer flex-col items-center gap-1 rounded-2xl border-2 border-transparent p-1.5 text-center text-[0.7rem] leading-tight font-semibold hover:bg-cream has-[:checked]:border-ink">
            <input type="radio" name="pv-preset" value={t.id} data-p={t.p} data-s={t.s} class="sr-only" />
            <span class="flex h-8 w-full overflow-hidden rounded-xl ring-1 ring-black/10" aria-hidden="true">
              <span class="flex-[3]" style={`background:${t.p}`}></span>
              <span class="flex-[2]" style={`background:${t.s}`}></span>
            </span>
            {t.label}
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class={section}>
      <legend class={title}>Sur mesure</legend>
      <div class="grid grid-cols-2 gap-3">
        <label class="flex items-center gap-2 text-sm font-semibold">
          <input type="color" id="pv-p" class="h-11 w-11 shrink-0 cursor-pointer rounded-xl border-2 border-line bg-white p-0.5" />
          Couleur principale
        </label>
        <label class="flex items-center gap-2 text-sm font-semibold">
          <input type="color" id="pv-s" class="h-11 w-11 shrink-0 cursor-pointer rounded-xl border-2 border-line bg-white p-0.5" />
          Couleur secondaire
        </label>
      </div>
      <p class="mt-2 text-xs text-muted">La principale colore les boutons, la secondaire les fonds et bandeaux. Les teintes de texte sont ajustées pour rester lisibles.</p>
    </fieldset>

    <div class="mt-4 flex flex-wrap gap-2">
      <button type="button" id="pv-share" class="btn-primary !min-h-11 !px-4 !py-2 !text-sm">Copier le lien de ce choix</button>
      <button type="button" id="pv-reset" class="btn-secondary !min-h-11 !px-4 !py-2 !text-sm">Réinitialiser</button>
    </div>
    <p id="pv-status" class="mt-2 min-h-5 text-xs font-semibold text-accent-ink" aria-live="polite"></p>
  </div>
</details>

<script is:inline type="application/json" id="pv-data" set:html={JSON.stringify({ brands: BRANDS, presets: PRESETS })}></script>

<script>
  type Brand = { id: string; name: string; domain: string };
  type State = { p?: string; s?: string; preset?: string; brand?: string };
  const RP = (window as any).RebondiPreview as { state: State; applyColors: (s: State) => void; save: (s: State) => void };
  const { brands } = JSON.parse(document.getElementById('pv-data')!.textContent!) as { brands: Brand[] };
  const state: State = RP.state;
  const panel = document.getElementById('preview-panel')!;
  const pIn = panel.querySelector<HTMLInputElement>('#pv-p')!;
  const sIn = panel.querySelector<HTMLInputElement>('#pv-s')!;
  const status = panel.querySelector<HTMLElement>('#pv-status')!;
  const DEFAULT = brands[0]!;

  // --- Nom du site : remplace le nom par défaut dans tous les textes de la page
  const textNodes: { node: Text; original: string }[] = [];
  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
  while (walker.nextNode()) {
    const n = walker.currentNode as Text;
    if (n.nodeValue && (n.nodeValue.includes(DEFAULT.name) || n.nodeValue.includes(DEFAULT.domain)) && !panel.contains(n)) {
      textNodes.push({ node: n, original: n.nodeValue });
    }
  }
  const originalTitle = document.title;
  function applyBrand() {
    const b = brands.find((x) => x.id === state.brand) ?? DEFAULT;
    const swap = (s: string) => s.split(DEFAULT.domain).join(b.domain).split(DEFAULT.name).join(b.name);
    textNodes.forEach(({ node, original }) => (node.nodeValue = swap(original)));
    document.title = swap(originalTitle);
    panel.querySelectorAll<HTMLInputElement>('input[name="pv-brand"]').forEach((r) => (r.checked = r.value === b.id));
  }

  // --- Couleurs
  const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
  function syncColorInputs() {
    pIn.value = state.p ?? css('--color-accent') ?? '#1d7a3e';
    sIn.value = state.s ?? css('--color-forest') ?? '#123d25';
    panel.querySelectorAll<HTMLInputElement>('input[name="pv-preset"]').forEach((r) => (r.checked = r.value === (state.preset || (!state.p ? 'prairie' : ''))));
  }
  function commit() {
    RP.applyColors(state);
    RP.save(state);
    syncColorInputs();
    status.textContent = '';
  }

  panel.querySelectorAll<HTMLInputElement>('input[name="pv-brand"]').forEach((r) =>
    r.addEventListener('change', () => { state.brand = r.value; RP.save(state); applyBrand(); }),
  );
  panel.querySelectorAll<HTMLInputElement>('input[name="pv-preset"]').forEach((r) =>
    r.addEventListener('change', () => {
      if (r.value === 'prairie') { delete state.p; delete state.s; state.preset = 'prairie'; }
      else { state.p = r.dataset.p; state.s = r.dataset.s; state.preset = r.value; }
      commit();
    }),
  );
  const custom = () => { state.p = pIn.value; state.s = sIn.value; state.preset = ''; commit(); };
  pIn.addEventListener('input', custom);
  sIn.addEventListener('input', custom);

  panel.querySelector('#pv-share')!.addEventListener('click', async () => {
    const url = new URL(location.href);
    url.search = '';
    if (state.p && state.s) { url.searchParams.set('p', state.p.slice(1)); url.searchParams.set('s', state.s.slice(1)); }
    if (state.preset) url.searchParams.set('palette', state.preset);
    if (state.brand && state.brand !== DEFAULT.id) url.searchParams.set('nom', state.brand);
    try { await navigator.clipboard.writeText(url.toString()); status.textContent = 'Lien copié ! Collez-le dans WhatsApp.'; }
    catch { status.textContent = url.toString(); }
  });
  panel.querySelector('#pv-reset')!.addEventListener('click', () => {
    delete state.p; delete state.s; delete state.brand; state.preset = 'prairie';
    commit(); applyBrand();
  });

  applyBrand();
  syncColorInputs();
</script>
