---
// Logo Rebondi : une balle qui rebondit (trajectoire en pointillés). Purement visuel : aria-hidden.
interface Props { class?: string; light?: boolean }
const { class: cls = '', light = false } = Astro.props;
---
<svg class={cls} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <circle cx="24" cy="24" r="23" class={light ? 'fill-meadow' : 'fill-accent'} />
  <path d="M8 34 Q14 10 21 34 Q27 18 33 34" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="0.1 4.2" />
  <circle cx="35.5" cy="22" r="6.5" class="fill-sun stroke-ink" stroke-width="2" />
  <path d="M30 37h12" stroke="#fff" stroke-width="2.6" stroke-linecap="round" />
</svg>
