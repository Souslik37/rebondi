---
// Sélecteur de palette, temporaire : sert à comparer les couleurs en ligne.
// Activé par "themePicker": true dans src/data/site.json. Le choix est mémorisé
// dans ce navigateur, et un lien ?theme=abricot permet de partager une palette.
import { THEMES } from '../lib/themes';
---
<details id="theme-picker" class="fixed bottom-24 left-3 z-50 md:bottom-4">
  <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-full border-2 border-ink bg-white px-4 text-sm font-bold text-ink shadow-lg [&::-webkit-details-marker]:hidden">
    <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="8.5" cy="10" r="1.6" fill="currentColor" /><circle cx="12" cy="7.5" r="1.6" fill="currentColor" /><circle cx="15.5" cy="10" r="1.6" fill="currentColor" /></svg>
    Couleurs
  </summary>
  <fieldset class="mt-2 w-64 rounded-3xl border-2 border-line bg-white p-3 shadow-xl">
    <legend class="sr-only">Choisir une palette de couleurs</legend>
    {THEMES.map((t) => (
      <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-2xl px-3 py-2 text-sm font-semibold text-ink hover:bg-cream has-[:checked]:bg-accent-soft">
        <input type="radio" name="site-theme" value={t.id} class="sr-only" />
        <span class="flex shrink-0 overflow-hidden rounded-full ring-1 ring-black/10" aria-hidden="true">
          {t.swatch.map((c) => <span class="h-6 w-4" style={`background:${c}`}></span>)}
        </span>
        {t.label}
      </label>
    ))}
  </fieldset>
</details>

<script>
  const KEY = 'rebondi-theme';
  const root = document.documentElement;
  const picker = document.getElementById('theme-picker')!;
  const radios = picker.querySelectorAll<HTMLInputElement>('input[name="site-theme"]');
  const current = root.dataset.theme ?? 'prairie';
  radios.forEach((r) => {
    r.checked = r.value === current;
    r.addEventListener('change', () => {
      root.dataset.theme = r.value;
      try { localStorage.setItem(KEY, r.value); } catch {}
    });
  });
</script>
