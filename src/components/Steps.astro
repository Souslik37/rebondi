---
import { site } from '../lib/data';
---
<ol class="grid gap-6 md:grid-cols-3" role="list">
  {site.fr.steps.map((s, i) => (
    <li class="card p-7">
      <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-accent text-2xl font-black text-ink" aria-hidden="true">{i + 1}</span>
      <h3 class="text-xl">{s.title}</h3>
      <p class="mt-2 text-muted">{s.text}</p>
    </li>
  ))}
</ol>
